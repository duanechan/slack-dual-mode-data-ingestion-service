APP_TITLE="Slack Dual-mode Data Ingestion Engine"
APP_VERSION="1.0.0"
ENVIRONMENT="dev"
HOST="localhost"
PORT=8000
SECURE=false

JWT_ACCESS_SECRET="REPLACE_WITH_JWT_ACCESS_SECRET"
JWT_EXPIRY_MINUTES=480
JWT_ALGORITHM="HS256"

SLACK_BOT_TOKEN="REPLACE_WITH_SLACK_BOT_TOKEN"

MINIO_ENDPOINT="localhost:9000"
MINIO_SECURE=false
MINIO_ACCESS_KEY="REPLACE_WITH_MINIO_ACCESS_KEY"
MINIO_SECRET_KEY="REPLACE_WITH_MINIO_SECRET_KEY"
MINIO_BUCKET="slack-ingestion-service-dev"

CLICKHOUSE_HOST="localhost"
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD="REPLACE_WITH_CLICKHOUSE_PASSWORD"
CLICKHOUSE_DB="slack"

LOG_LEVEL="info"
LOG_FORMAT="json"
